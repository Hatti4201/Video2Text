{
  "manifest_version": 3,
  "name": "Video2Text",
  "version": "1.1.10",
  "description": "Read existing YouTube captions as a transcript, entirely in Chrome.",
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"],
      "css": ["theme.css", "content.css"],
      "run_at": "document_idle"
    }
  ]
}
